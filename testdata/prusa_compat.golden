== parseLocationParam ==
"XL - Toolhead 0" -> printer="XL" toolhead=0 location="XL - Toolhead 0" printer_location=true err=<nil>
"XL - Toolhead 4" -> printer="XL" toolhead=4 location="XL - Toolhead 4" printer_location=true err=<nil>
"XL - Silk Head" -> printer="XL" toolhead=2 location="XL - Silk Head" printer_location=true err=<nil>
"XL - Toolhead 2" -> printer="XL" toolhead=2 location="XL - Toolhead 2" printer_location=true err=<nil>
"XL - Toolhead 5" -> printer="" toolhead=0 location="XL - Toolhead 5" printer_location=false err=<nil>
"XL - Toolhead 7" -> printer="" toolhead=0 location="XL - Toolhead 7" printer_location=false err=<nil>
"TestPrinter - Toolhead 0" -> printer="TestPrinter" toolhead=0 location="TestPrinter - Toolhead 0" printer_location=true err=<nil>
"Ghost - Toolhead 0" -> printer="" toolhead=0 location="Ghost - Toolhead 0" printer_location=false err=<nil>
"Drybox" -> printer="" toolhead=0 location="Drybox" printer_location=false err=<nil>

