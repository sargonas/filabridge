== webhook payloads ==
{
  "auto_paused": true,
  "event": "low_filament",
  "message": "Spool \"Spool 14\" (ID 14) on XL toolhead 4 is short by 60.0g: 20.0g remaining, print needs ~80.0g. The print has been paused; swap the spool, then acknowledge the warning in FilaBridge (or resume at the printer).",
  "printer": "XL",
  "remaining_weight_g": 20,
  "required_weight_g": 80,
  "spool_id": 14,
  "spool_name": "Spool 14",
  "timestamp": "\u003cvolatile\u003e",
  "title": "Print auto-paused on XL (low filament)",
  "toolhead_id": 4
}
{
  "event": "unknown_filament_slot",
  "filename": "part.bgcode",
  "message": "XL is printing ~33.3g from a single-filament slice, which does not record which slot it used. FilaBridge will record it against toolhead 2. Confirm that is the toolhead it is really printing from, or pick the right one on the dashboard before the print finishes.",
  "printer": "XL",
  "timestamp": "\u003cvolatile\u003e",
  "title": "Confirm toolhead mapping on XL",
  "toolhead_id": 2,
  "unrecorded_weight_g": 33.3
}

